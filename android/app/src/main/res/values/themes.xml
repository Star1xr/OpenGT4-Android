<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws its own theme; the Activity only provides the window.
         A platform theme keeps the Material Components dependency out. -->
    <style name="Theme.OpenGT4" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
        <item name="android:navigationBarColor">@color/launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.OpenGT4.Game" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
